---
interface Props { eyebrow?: string; title: string; text?: string; align?: 'center' | 'left' }
const { eyebrow, title, text, align = 'center' } = Astro.props;
---
<div class="sec-head" style={align === 'left' ? 'text-align:left;margin-left:0' : undefined}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <h2>{title}</h2>
  {text && <p>{text}</p>}
</div>
