---
import { site } from '../site';
import Icon from './Icon.astro';
---
<div class="chat-root" data-phone={site.phoneDisplay} data-tel={site.phoneTel}>
  <button class="chat-fab" aria-label="Chat with us" aria-expanded="false" aria-controls="chat-panel">
    <Icon name="chat" size={26} />
    <span class="fab-label">Questions? Chat</span>
  </button>

  <div id="chat-panel" class="chat-panel" hidden role="dialog" aria-label="Chat with Fresh Start Home Buyers">
    <div class="chat-head">
      <div>
        <b>Fresh Start assistant</b>
        <small>Ask anything, or leave your details for Austin</small>
      </div>
      <button class="chat-close" aria-label="Close chat">×</button>
    </div>
    <div class="chat-log" aria-live="polite"></div>
    <form class="chat-form">
      <input class="chat-input" type="text" name="message" placeholder="Type your question…" autocomplete="off" maxlength="1000" required />
      <button class="chat-send" type="submit" aria-label="Send">➤</button>
    </form>
    <p class="chat-fine">AI assistant. Austin personally reads every lead. <a href="/privacy/">Privacy</a></p>
  </div>
</div>

<style is:global>
  .chat-root{position:fixed;right:18px;bottom:18px;z-index:50;font-family:'Poppins',sans-serif}
  .chat-fab{display:flex;align-items:center;gap:10px;background:var(--gold);color:var(--green-d);border:none;border-radius:999px;padding:12px 18px 12px 14px;font-weight:600;font-size:.95rem;cursor:pointer;box-shadow:0 8px 24px rgba(23,52,41,.25);font-family:inherit}
  .chat-fab:hover{background:var(--gold-d);color:#fff}
  .chat-panel{position:absolute;right:0;bottom:64px;width:360px;max-width:calc(100vw - 36px);height:520px;max-height:calc(100vh - 110px);background:#fff;border-radius:16px;box-shadow:0 18px 50px rgba(23,52,41,.28);display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--line)}
  .chat-panel[hidden]{display:none}
  .chat-head{background:var(--green);color:var(--cream);padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px}
  .chat-head b{display:block;font-family:'Lora',serif;font-size:1.05rem}
  .chat-head small{font-size:.76rem;color:var(--on-green)}
  .chat-close{background:none;border:none;color:var(--cream);font-size:1.6rem;line-height:1;cursor:pointer;padding:0 4px}
  .chat-log{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;background:var(--cream)}
  .msg{max-width:85%;padding:10px 13px;border-radius:14px;font-size:.92rem;line-height:1.5;white-space:pre-wrap;word-wrap:break-word}
  .msg.bot{background:#fff;border:1px solid var(--line);border-bottom-left-radius:4px;align-self:flex-start;color:var(--ink)}
  .msg.user{background:var(--green);color:var(--cream);border-bottom-right-radius:4px;align-self:flex-end}
  .msg.typing{color:var(--muted);font-style:italic}
  .msg a{color:var(--green);font-weight:600}
  .chat-form{display:flex;gap:8px;padding:10px;border-top:1px solid var(--line);background:#fff}
  .chat-input{flex:1;font-size:.92rem;padding:10px 12px}
  .chat-send{background:var(--gold);color:var(--green-d);border:none;border-radius:8px;padding:0 16px;font-size:1rem;cursor:pointer}
  .chat-send:disabled{opacity:.5;cursor:default}
  .chat-fine{font-size:.7rem;color:var(--muted);text-align:center;padding:0 10px 8px;margin:0;background:#fff}
  .chat-fine a{color:var(--green)}
  @media(max-width:760px){
    .chat-root{bottom:74px;right:12px}
    .chat-panel{position:fixed;left:8px;right:8px;bottom:8px;width:auto;max-width:none;height:auto;top:8px;max-height:none}
    .fab-label{display:none}
    .chat-fab{padding:14px}
  }
</style>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const root = document.querySelector<HTMLElement>('.chat-root')!;
  const fab = root.querySelector<HTMLButtonElement>('.chat-fab')!;
  const panel = root.querySelector<HTMLElement>('.chat-panel')!;
  const closeBtn = root.querySelector<HTMLButtonElement>('.chat-close')!;
  const log = root.querySelector<HTMLElement>('.chat-log')!;
  const form = root.querySelector<HTMLFormElement>('.chat-form')!;
  const input = root.querySelector<HTMLInputElement>('.chat-input')!;
  const send = root.querySelector<HTMLButtonElement>('.chat-send')!;
  const phone = root.dataset.phone ?? '';
  const tel = root.dataset.tel ?? '';
  const KEY = 'fs-chat';
  const MAX_TURNS = 30;

  const greeting =
    `Hi, I’m the assistant for Fresh Start Home Buyers. I can answer questions about selling your house, or take your details so Austin can reach out with real options. What’s on your mind?`;

  let messages: Msg[] = [];
  try { messages = JSON.parse(sessionStorage.getItem(KEY) ?? '[]'); } catch { messages = []; }

  function save() { try { sessionStorage.setItem(KEY, JSON.stringify(messages.slice(-MAX_TURNS))); } catch {} }

  function linkify(text: string): string {
    const esc = text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    return esc.replace(/\(?\b\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}\b/g, (m) => `<a href="tel:${tel}">${m}</a>`);
  }

  function render() {
    log.innerHTML = '';
    const all: Msg[] = messages.length ? messages : [{ role: 'assistant', content: greeting }];
    for (const m of all) {
      const el = document.createElement('div');
      el.className = `msg ${m.role === 'user' ? 'user' : 'bot'}`;
      if (m.role === 'assistant') el.innerHTML = linkify(m.content); else el.textContent = m.content;
      log.appendChild(el);
    }
    log.scrollTop = log.scrollHeight;
  }

  function open(o: boolean) {
    panel.hidden = !o;
    fab.setAttribute('aria-expanded', String(o));
    if (o) { render(); input.focus(); }
  }
  fab.addEventListener('click', () => open(panel.hidden === true));
  closeBtn.addEventListener('click', () => open(false));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    if (!messages.length) messages.push({ role: 'assistant', content: greeting });
    messages.push({ role: 'user', content: text });
    input.value = '';
    save(); render();

    const typing = document.createElement('div');
    typing.className = 'msg bot typing';
    typing.textContent = 'Typing…';
    log.appendChild(typing);
    log.scrollTop = log.scrollHeight;
    send.disabled = true; input.disabled = true;

    try {
      const res = await fetch('/.netlify/functions/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: messages.slice(-MAX_TURNS), page: location.pathname }),
      });
      const data = await res.json().catch(() => ({}));
      const reply: string = data.reply || `Sorry, I’m having trouble right now. You can call or text Austin directly at ${phone}.`;
      messages.push({ role: 'assistant', content: reply });
    } catch {
      messages.push({ role: 'assistant', content: `Looks like I lost the connection. You can call or text Austin directly at ${phone}.` });
    } finally {
      send.disabled = false; input.disabled = false;
      save(); render(); input.focus();
    }
  });
</script>
