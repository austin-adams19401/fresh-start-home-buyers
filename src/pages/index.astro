---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Steps from '../components/Steps.astro';
import CompareTable from '../components/CompareTable.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import OfferSection from '../components/OfferSection.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';
import { faqs } from '../data/faqs';

const situations = (await getCollection('situations')).sort((a, b) => a.data.order - b.data.order);
const homeFaqs = faqs.slice(0, 4);
---
<BaseLayout
  title="Fresh Start Home Buyers | Sell Your House Fast in Davis & Weber County, Utah"
  description="Local home buyer in Kaysville, Utah. Cash offers, creative financing, or honest advice to list. Sell as-is, no fees, no pressure, close on your timeline. Call or text (385) 244-0881."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Davis &amp; Weber County, Utah</div>
        <h1>Sell your house on your terms. Not the market’s.</h1>
        <p class="lede">I’m Austin, a local investor in Kaysville. Whether you need a fast cash sale, flexible terms, or just an honest opinion on what your house is worth, you’ll get a straight answer and zero pressure.</p>
        <div class="cta">
          <a class="btn btn-gold" href="/get-offer/">Get my cash offer</a>
          <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Call or text {site.phoneDisplay}</a>
        </div>
        <ul class="hero-points">
          <li><Icon name="shield" size={18} /> No agent fees or commissions</li>
          <li><Icon name="wrench" size={18} /> Sell as-is, any condition</li>
          <li><Icon name="calendar" size={18} /> Close in as little as 10 days, or on your date</li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src="/images/austin-wide.jpg" alt="Austin Adams, local home buyer in Kaysville, Utah, smiling on a trail above the Wasatch Front at sunset" width="1400" height="933" fetchpriority="high" />
        <div class="badge"><Icon name="pin" size={18} /> Based in Kaysville. I answer my own phone.</div>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">More than one way to sell</div>
        <h2>Four ways I can help</h2>
        <p>Most "we buy houses" companies have one tool: a lowball cash offer. I’d rather find the option that actually nets you the most, even if it isn’t selling to me.</p>
      </div>
      <ServiceCards />
      <p class="center" style="margin-top:28px"><a class="btn btn-outline" href="/compare/">Compare the options side by side</a></p>
    </div>
  </section>

  <section class="bg-cream-2" id="situations">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Whatever you’re facing</div>
        <h2>A fresh start, whatever the situation</h2>
        <p>Life happens. If you need to sell and a traditional listing doesn’t fit, there’s usually a simpler way forward.</p>
      </div>
      <div class="grid grid-3">
        {situations.map((s) => (
          <a class="card" href={`/situations/${s.id}/`}>
            <div class="ic"><Icon name={s.data.icon} /></div>
            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>
            <span class="more">Read more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Simple and transparent</div>
        <h2>How it works</h2>
        <p>Three steps, no obligation at any point.</p>
      </div>
      <Steps />
      <p class="center" style="margin-top:28px"><a href="/how-it-works/" class="btn btn-outline">See the full process</a></p>
    </div>
  </section>

  <section class="bg-green about-strip">
    <div class="wrap about-grid">
      <img src="/images/austin-square.jpg" alt="Austin Adams" width="400" height="400" loading="lazy" />
      <div>
        <div class="eyebrow">Who you’re working with</div>
        <h2>A neighbor, not a call center</h2>
        <p>I live in Kaysville with my wife and our kids. I got into real estate because I like solving problems, and the people who need help most are usually the ones facing something hard: a foreclosure notice, a divorce, a house full of a parent’s belongings, a rental that has become a second job.</p>
        <p>My goal is simple: build relationships where both sides win. Sometimes that means buying your house. Sometimes it means telling you to list it. Either way, you’ll get the truth.</p>
        <a class="btn btn-gold" href="/about/">More about Austin</a>
      </div>
    </div>
  </section>

  <section id="compare">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Know your options</div>
        <h2>Cash offer vs. creative terms vs. listing</h2>
        <p>There is no single right answer. Here is how the three main routes usually compare.</p>
      </div>
      <CompareTable />
    </div>
  </section>

  <Testimonials />

  <section class="bg-cream-2">
    <div class="wrap" style="max-width:820px">
      <div class="sec-head">
        <div class="eyebrow">Common questions</div>
        <h2>Things sellers ask me</h2>
      </div>
      <Faq items={homeFaqs} />
      <p class="center" style="margin-top:22px"><a href="/faq/" class="btn btn-outline">See all questions</a></p>
    </div>
  </section>

  <OfferSection />
</BaseLayout>

<style>
  .hero{background:var(--green);color:var(--cream);position:relative;overflow:hidden;padding:64px 0 72px}
  .hero-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center}
  .hero h1{color:var(--cream);margin:12px 0 18px}
  .hero .lede{font-size:clamp(1.05rem,2vw,1.2rem);color:var(--on-green);max-width:560px;margin-bottom:26px}
  .hero .cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px}
  .hero-points{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;color:var(--on-green);font-size:.94rem}
  .hero-points li{display:flex;align-items:center;gap:10px}
  .hero-points svg{color:var(--gold);flex:0 0 auto}
  .hero-photo{position:relative}
  .hero-photo img{border-radius:18px;box-shadow:0 24px 60px rgba(0,0,0,.35);width:100%;height:auto;object-fit:cover;aspect-ratio:3/2}
  .badge{position:absolute;left:18px;bottom:18px;background:var(--cream);color:var(--green-d);font-size:.82rem;font-weight:600;padding:9px 14px;border-radius:999px;display:flex;align-items:center;gap:8px;box-shadow:0 6px 18px rgba(0,0,0,.25)}
  .badge svg{color:var(--gold)}
  .about-grid{display:grid;grid-template-columns:320px 1fr;gap:48px;align-items:center}
  .about-grid img{border-radius:50%;width:100%;max-width:320px;height:auto;aspect-ratio:1;object-fit:cover;border:6px solid rgba(255,255,255,.1)}
  .about-grid h2{margin:10px 0 14px}
  .about-grid .btn{margin-top:6px}
  @media(max-width:900px){
    .hero-grid{grid-template-columns:1fr}
    .hero{padding:48px 0 56px}
    .hero-photo{order:-1;max-width:520px}
    .about-grid{grid-template-columns:1fr;text-align:center}
    .about-grid img{margin:0 auto;max-width:220px}
  }
</style>
